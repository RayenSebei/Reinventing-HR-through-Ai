# Copy values into your shell or local .env loader. The app does not automatically
# load this file. Never commit real secrets or candidate data.
VOUCH_DATA_DIR=./vouch/data
VOUCH_JWT_SECRET=replace-with-a-long-random-secret
VOUCH_LEDGER_KEY=replace-with-at-least-32-bytes-of-random-secret
VOUCH_DEMO_MODE=1
VOUCH_TOKEN_MINUTES=480
VOUCH_RETENTION_DAYS=180

VOUCH_PUBLIC_BASE_URL=http://127.0.0.1:8000
VOUCH_INTERVIEW_MINUTES=20
VOUCH_INTERVIEW_INVITE_HOURS=72
VOUCH_INTERVIEW_MAX_ANSWER_CHARS=2000
VOUCH_INTERVIEW_RATE_PER_MINUTE=60

# lexicon (offline, default) | openai | ollama | replay
VOUCH_MODEL=lexicon
VOUCH_OPENAI_BASE_URL=https://api.openai.com/v1
VOUCH_OPENAI_API_KEY=
VOUCH_OPENAI_MODEL=
VOUCH_OLLAMA_URL=http://127.0.0.1:11434
VOUCH_OLLAMA_MODEL=qwen3:8b

# Optional external delivery. Leave blank for the sandbox outbox.
VOUCH_N8N_WEBHOOK_URL=
VOUCH_N8N_HMAC_SECRET=
