# Copy to .env and edit. Never commit .env.

# Long random string (python -c "import secrets;print(secrets.token_urlsafe(48))").
IB_SECRET_KEY=change-me

# Where the candidate link points (include the port you use).
IB_PUBLIC_BASE_URL=http://localhost:8000

# Interview timer: minutes the candidate has once the interview starts (0 = no limit).
IB_INTERVIEW_TIME_LIMIT_MIN=20

# LLM used for CV evidence and follow-up questions:
# mock (offline, no key) | openai (any OpenAI-compatible API: OpenAI, Groq, Ollama...) | anthropic
IB_LLM_PROVIDER=mock
IB_LLM_MODEL=
IB_LLM_API_KEY=
IB_LLM_BASE_URL=https://api.openai.com/v1
IB_LLM_CACHE=1

IB_DB_PATH=interview_bot.db
IB_INVITE_TTL_HOURS=72
IB_RETENTION_DAYS=90
IB_RATE_LIMIT_PER_MINUTE=20
IB_MAX_ANSWER_CHARS=2000

# Demo data (4 users, 1 job, 4 fictional CVs) on first start. Set 0 outside the demo.
IB_DEMO_SEED=1
IB_DEMO_PASSWORD=demo-pass-2026
