# Vouch settings. Copy to your shell or a local .env (never commit real values).
# The server refuses to start with unsafe or incomplete combinations (config.validate).

# Outbound kill switch: disabled | sink | live   (default sink: nothing leaves the machine)
VOUCH_OUTBOUND_MODE=sink
# Needed only for VOUCH_OUTBOUND_MODE=live. Secret: at least 32 random characters, same as in n8n.
VOUCH_N8N_WEBHOOK_URL=
VOUCH_N8N_HMAC_SECRET=

# Demo mode: seeded users get the documented password demo1234 and the sign-in page shows account
# shortcuts. Without it, --seed prints a one-time random password. Not allowed with live outbound.
VOUCH_DEMO_MODE=0

# Keep login sessions across restarts (otherwise a random key per process).
VOUCH_JWT_SECRET=

# Model: lexicon | openai | ollama | replay | stub (stub is for tests)
VOUCH_MODEL=lexicon
VOUCH_OPENAI_BASE_URL=https://api.openai.com/v1
VOUCH_OPENAI_API_KEY=
VOUCH_OPENAI_MODEL=

# Human-in-the-loop
VOUCH_APPROVAL_MINUTES=15
VOUCH_REVIEW_TOP_N=3
VOUCH_MAX_DELIVERY_ATTEMPTS=5

# HR assistants: on (default) or off. off makes the routes answer 404 FEATURE_OFF.
FEAT_SLOTS_MODE=on
FEAT_REPLY_TRACKING_MODE=on
FEAT_INBOX_MODE=on
FEAT_REPLIES_MODE=on
FEAT_HR_QA_MODE=on
# Days without an answer before a sent message is flagged for a follow-up.
VOUCH_REPLY_WAIT_DAYS=3
# Working hours used to suggest interview slots (local time of the chosen time zone).
VOUCH_WORK_START_HOUR=9
VOUCH_WORK_END_HOUR=17
# Largest .eml file the AI Inbox accepts (bytes).
VOUCH_MAX_EML_BYTES=262144
