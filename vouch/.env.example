# Vouch settings. Copy to your shell or a local .env (never commit real values).
# The server refuses to start with unsafe or incomplete combinations (config.validate).

# Outbound kill switch: disabled | sink | live   (default sink: nothing leaves the machine)
VOUCH_OUTBOUND_MODE=sink
# Needed only for VOUCH_OUTBOUND_MODE=live. Secret: at least 32 random characters, same as in n8n.
VOUCH_N8N_WEBHOOK_URL=
VOUCH_N8N_HMAC_SECRET=

# Demo mode: seeded users get the documented password demo1234. Not allowed with live outbound.
VOUCH_DEMO=0

# Keep login sessions across restarts (otherwise a random key per process).
VOUCH_JWT_SECRET=

# Model: lexicon | openai | ollama | replay | stub (stub is for tests)
VOUCH_MODEL=lexicon
VOUCH_OPENAI_BASE_URL=https://api.openai.com/v1
VOUCH_OPENAI_API_KEY=
VOUCH_OPENAI_MODEL=

# Human-in-the-loop
VOUCH_APPROVAL_MINUTES=15
VOUCH_REVIEW_TOP_N=3
VOUCH_MAX_DELIVERY_ATTEMPTS=5
